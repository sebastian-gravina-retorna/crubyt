# --- Frontend (públicas, se incluyen en el bundle) ---
# Supabase: blog, casos de éxito y newsletter. Sin ellas el sitio usa src/content/posts.json.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Servidor (Vercel Functions, NUNCA con prefijo VITE_) ---
# Formulario de contacto vía Resend (api/contact.ts)
RESEND_API_KEY=re_xxx
# Destinatario(s) separados por coma (default: info@crubyt.com)
CONTACT_TO=info@crubyt.com
# Remitente de un dominio verificado en Resend (default: onboarding@resend.dev, solo pruebas)
CONTACT_FROM=Crubyt Web <web@crubyt.com>
# Guardar los contactos en Supabase (tabla contacts). Secret key: Supabase → Settings → API Keys
SUPABASE_SECRET_KEY=sb_secret_xxx
