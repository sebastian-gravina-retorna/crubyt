# Supabase (blog, casos de éxito y newsletter). Si no se configuran, el sitio usa el contenido local de src/content.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Endpoint para el formulario de contacto (Formspree, Make, n8n, HubSpot, etc.). POST JSON.
# Si se deja vacío, el formulario abre el cliente de correo hacia info@crubyt.com.
VITE_CONTACT_ENDPOINT=
